{% extends 'base.html.twig' %}

{% block title %}Encadrant - Mes stages{% endblock %}

{% block body %}
<h1 class="mb-4"><i class="fas fa-briefcase"></i> Mes stages</h1>

{% if stages is empty %}
    <div class="alert alert-info">Aucun stage affecté.</div>
{% else %}
    <div class="table-responsive">
        <table class="table table-striped">
            <thead class="thead-dark">
            <tr>
                <th>Titre</th>
                <th>Type</th>
                <th>Durée</th>
                <th>Département</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for s in stages %}
                <tr>
                    <td>{{ s.titre }}</td>
                    <td>{{ s.typestage }}</td>
                    <td>{{ s.duree }}</td>
                    <td>{{ s.department ? s.department.nom : '' }}</td>
                    <td>
                        <a class="btn btn-sm btn-info" href="{{ path('app_stage_show', {'id': s.id}) }}">Voir</a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}
