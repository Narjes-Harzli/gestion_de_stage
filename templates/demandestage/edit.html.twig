{% extends 'base.html.twig' %}

{% block title %}Modifier demande{% endblock %}

{% block body %}
<h1 class="mb-4">Modifier la demande</h1>

<div class="card">
    <div class="card-body">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            {{ form_widget(form) }}
            <button class="btn btn-warning">Mettre à jour</button>
            <a class="btn btn-secondary" href="{{ path('app_demandestage_index') }}">Retour</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
