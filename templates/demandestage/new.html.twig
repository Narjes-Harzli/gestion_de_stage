{% extends 'base.html.twig' %}

{% block title %}Nouvelle demande{% endblock %}

{% block body %}
<h1 class="mb-4">Nouvelle demande de stage</h1>

<div class="card">
    <div class="card-body">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            {{ form_row(form.stage) }}
            <button class="btn btn-info">Enregistrer</button>
            <a class="btn btn-secondary" href="{{ path('app_demandestage_index') }}">Retour</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
