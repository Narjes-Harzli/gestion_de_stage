{% extends 'base.html.twig' %}

{% block title %}Demandes de stage{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-file-alt"></i> Demandes de stage</h1>
    {% if is_granted('ROLE_ETUDIANT') %}
        <a href="{{ path('app_demandestage_new') }}" class="btn btn-info">Nouvelle</a>
    {% endif %}
</div>

<div class="card">
    <div class="card-body">
        {% if demandestages is empty %}
            <div class="alert alert-info mb-0">Aucune demande.</div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="thead-dark">
                    <tr>
                        <th>Étudiant</th>
                        <th>Stage</th>
                        <th>Statut</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for d in demandestages %}
                        <tr>
                            <td>{{ d.etudiant.email }}</td>
                            <td>{{ d.stage.titre }}</td>
                            <td>{{ d.statut }}</td>
                            <td>{{ d.datedemande|date('d/m/Y') }}</td>
                            <td>
                                <a class="btn btn-sm btn-info" href="{{ path('app_demandestage_show', {'id': d.id}) }}">Voir</a>
                                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENCADRANT') or (is_granted('ROLE_ETUDIANT') and app.user and d.etudiant.id == app.user.id) %}
                                    <a class="btn btn-sm btn-warning" href="{{ path('app_demandestage_edit', {'id': d.id}) }}">Modifier</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
