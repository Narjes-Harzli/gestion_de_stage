{% extends 'base.html.twig' %}

{% block title %}Encadrant index{% endblock %}

{% block body %}
    <h1>Encadrant index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>Email</th>
                <th>Telephone</th>
                <th>Specialite</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for encadrant in encadrants %}
            <tr>
                <td>{{ encadrant.id }}</td>
                <td>{{ encadrant.nom }}</td>
                <td>{{ encadrant.prenom }}</td>
                <td>{{ encadrant.email }}</td>
                <td>{{ encadrant.telephone }}</td>
                <td>{{ encadrant.specialite }}</td>
                <td>
                    <a href="{{ path('app_encadrant_show', {'id': encadrant.id}) }}">show</a>
                    <a href="{{ path('app_encadrant_edit', {'id': encadrant.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_encadrant_new') }}">Create new</a>
{% endblock %}
