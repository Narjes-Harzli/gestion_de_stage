{% extends 'base.html.twig' %}

{% block title %}Modifier Stage{% endblock %}

{% block body %}
<h1 class="mb-4">Modifier le stage</h1>

<div class="card">
    <div class="card-body">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            {{ form_row(form.titre) }}
            {{ form_row(form.typestage) }}
            {{ form_row(form.description) }}
            {{ form_row(form.duree) }}
            {{ form_row(form.department) }}
            <button class="btn btn-warning">Mettre à jour</button>
            <a class="btn btn-secondary" href="{{ path('app_stage_index') }}">Retour</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
