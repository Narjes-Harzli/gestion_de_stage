{% extends 'base.html.twig' %}

{% block title %}Stages{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-briefcase"></i> Stages</h1>
    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENCADRANT') %}
        <a href="{{ path('app_stage_new') }}" class="btn btn-warning">Ajouter</a>
    {% endif %}
</div>

<div class="card">
    <div class="card-body">
        {% if stages is empty %}
            <div class="alert alert-info mb-0">Aucun stage.</div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="thead-dark">
                    <tr>
                        <th>Titre</th>
                        <th>Type</th>
                        <th>Durée</th>
                        <th>Département</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for stage in stages %}
                        <tr>
                            <td>{{ stage.titre }}</td>
                            <td>{{ stage.typestage }}</td>
                            <td>{{ stage.duree }}</td>
                            <td>{{ stage.department.nom }}</td>
                            <td>
                                <a class="btn btn-sm btn-info" href="{{ path('app_stage_show', {'id': stage.id}) }}">Voir</a>
                                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENCADRANT') %}
                                    <a class="btn btn-sm btn-warning" href="{{ path('app_stage_edit', {'id': stage.id}) }}">Modifier</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
