{% extends 'base_tekup.html.twig' %}

{% block title %}Créer un compte - Tek-Up{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-lg border-0" style="background-color: var(--tek-blue);">
            <div class="card-header text-white text-center border-0">
                <img src="{{ asset('images/logo-tekup.png') }}" alt="Tek-Up" style="height: 80px;">
                <h4 class="mb-0 mt-2">Créer un compte</h4>
            </div>
            <div class="card-body bg-white">
                {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}
                    <div class="mb-3">
                        {{ form_label(registrationForm.email) }}
                        {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(registrationForm.role) }}
                        {{ form_widget(registrationForm.role, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(registrationForm.role) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(registrationForm.plainPassword, 'Mot de passe') }}
                        {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-tek">Créer le compte</button>
                    </div>
                {{ form_end(registrationForm) }}

                <div class="text-center mt-3">
                    <a href="{{ path('app_login') }}">Déjà un compte ? Se connecter</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
