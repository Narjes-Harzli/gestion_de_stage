<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Tek-Up Stages{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --tek-blue: #003d7e;
            --tek-white: #ffffff;
        }
        .bg-tek-blue { background-color: var(--tek-blue) !important; }
        .btn-tek {
            background-color: var(--tek-blue);
            color: var(--tek-white);
            border: none;
        }
        .btn-tek:hover { filter: brightness(1.1); color: var(--tek-white); }
        .navbar-brand img { height: 40px; }
        footer { background-color: #f8f9fa; font-size: 0.9rem; }

        /* Ajout rapide : fond bleu Tek-Up sur les card-header */
        .card-header {
            background-color: var(--tek-blue) !important;
            color: var(--tek-white) !important;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg navbar-dark bg-tek-blue">
  <div class="container-fluid">
    <a class="navbar-brand" href="{{ path('app_login') }}">
        <img src="{{ asset('images/logo-tekup.png') }}" alt="Tek-Up">
    </a>
    <div class="ms-auto d-flex align-items-center text-white">
        {% if app.user %}
            Bonjour {{ app.user.email }} &nbsp;
            <a href="{{ path('app_logout') }}" class="btn btn-sm btn-light">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-sm btn-light">Connexion</a>
        {% endif %}
    </div>
  </div>
</nav>

<main class="container my-4">
    {% for flash in app.flashes('success') %}
        <div class="alert alert-success">{{ flash }}</div>
    {% endfor %}
    {% block body %}{% endblock %}
</main>

<footer class="mt-auto py-3 text-center text-muted">
    &copy; {{ "now"|date("Y") }} Tek-Up – Gestion des stages
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>