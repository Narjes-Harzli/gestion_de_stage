<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Gestion des Stages{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home_public') }}">
                <i class="fas fa-graduation-cap"></i> Gestion des Stages
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home_public') }}">
                            <i class="fas fa-home"></i> Accueil
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown">
                            <i class="fas fa-users"></i> Étudiants
                        </a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="{{ path('app_etudiant_index') }}">Liste des étudiants</a>
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENCADRANT') %}
                                <a class="dropdown-item" href="{{ path('app_etudiant_new') }}">Ajouter un étudiant</a>
                            {% endif %}
                        </div>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown2" role="button" data-toggle="dropdown">
                            <i class="fas fa-building"></i> Départements
                        </a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="{{ path('app_department_index') }}">Liste des départements</a>
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENCADRANT') %}
                                <a class="dropdown-item" href="{{ path('app_department_new') }}">Ajouter un département</a>
                            {% endif %}
                        </div>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown3" role="button" data-toggle="dropdown">
                            <i class="fas fa-briefcase"></i> Stages
                        </a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="{{ path('app_stage_index') }}">Liste des stages</a>
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENCADRANT') %}
                                <a class="dropdown-item" href="{{ path('app_stage_new') }}">Ajouter un stage</a>
                            {% endif %}
                        </div>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown4" role="button" data-toggle="dropdown">
                            <i class="fas fa-file-alt"></i> Demandes
                        </a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="{{ path('app_demandestage_index') }}">Liste des demandes</a>
                            {% if is_granted('ROLE_ETUDIANT') %}
                                <a class="dropdown-item" href="{{ path('app_demandestage_new') }}">Nouvelle demande</a>
                            {% endif %}
                        </div>
                    </li>

                    {% if is_granted('ROLE_ENCADRANT') %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownEnc" role="button" data-toggle="dropdown">
                                <i class="fas fa-chalkboard-teacher"></i> Encadrant
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" href="{{ path('app_encadrant_dashboard') }}">Tableau de bord</a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="{{ path('app_encadrant_space_stages') }}">Mes stages</a>
                                <a class="dropdown-item" href="{{ path('app_encadrant_space_demandes') }}">Demandes de mes stages</a>
                                <a class="dropdown-item" href="{{ path('app_encadrant_space_etudiants') }}">Étudiants encadrés</a>
                                <a class="dropdown-item" href="{{ path('app_encadrant_space_documents') }}">Documents</a>
                            </div>
                        </li>
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENCADRANT') or is_granted('ROLE_ETUDIANT') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_document_index') }}">
                                <i class="fas fa-folder-open"></i> Documents
                            </a>
                        </li>
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownAdmin" role="button" data-toggle="dropdown">
                                <i class="fas fa-user-shield"></i> Admin
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" href="{{ path('app_admin') }}">Dashboard</a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="{{ path('app_admin_user_index') }}">Utilisateurs</a>
                            </div>
                        </li>
                    {% endif %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarAccount" role="button" data-toggle="dropdown">
                            <i class="fas fa-user"></i> Compte
                        </a>
                        <div class="dropdown-menu dropdown-menu-right">
                            {% if app.user %}
                                <span class="dropdown-item-text">{{ app.user.email }}</span>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a>
                            {% else %}
                                <a class="dropdown-item" href="{{ path('app_login') }}">Connexion</a>
                                <a class="dropdown-item" href="{{ path('app_register') }}">Créer un compte</a>
                            {% endif %}
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        {% block body %}{% endblock %}
    </main>

    <footer class="bg-light text-center py-3 mt-5">
        <div class="container">
            <p class="mb-0">&copy; 2024 - Application de Gestion des Stages</p>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
