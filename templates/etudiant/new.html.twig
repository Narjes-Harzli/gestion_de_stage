{% extends 'base.html.twig' %}

{% block title %}Nouveau Étudiant{% endblock %}

{% block body %}
<h1 class="mb-4">Ajouter un étudiant</h1>

<div class="card">
    <div class="card-body">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            {{ form_row(form.nom) }}
            {{ form_row(form.prenom) }}
            {{ form_row(form.email) }}
            {{ form_row(form.telephone) }}

            <button class="btn btn-primary">Enregistrer</button>
            <a class="btn btn-secondary" href="{{ path('app_etudiant_index') }}">Retour</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
