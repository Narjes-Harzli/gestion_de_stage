{% extends 'base.html.twig' %}

{% block title %}Accueil - Gestion des Stages{% endblock %}

{% block stylesheets %}
<style>
.hero-section {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 100px 0;
    position: relative;
    overflow: hidden;
}

.hero-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('https://images.unsplash.com/photo-1523050854058-8df90110c9f1?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80') center/cover;
    opacity: 0.3;
    z-index: 0;
}

.hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
}

.hero-title {
    font-size: 3.5rem;
    font-weight: bold;
    margin-bottom: 1.5rem;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
}

.hero-subtitle {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    opacity: 0.9;
}

.feature-card {
    background: white;
    border-radius: 15px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
}

.feature-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
}

.feature-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    font-size: 2rem;
}

.feature-title {
    color: #333;
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 1rem;
}

.feature-description {
    color: #666;
    line-height: 1.6;
}

.cta-section {
    background: #f8f9fa;
    padding: 80px 0;
    text-align: center;
}

.cta-title {
    font-size: 2.5rem;
    color: #333;
    margin-bottom: 1rem;
}

.cta-subtitle {
    font-size: 1.2rem;
    color: #666;
    margin-bottom: 2rem;
}

.btn-cta {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 15px 40px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: bold;
    transition: transform 0.3s ease;
    display: inline-block;
    margin: 0 10px;
}

.btn-cta:hover {
    color: white;
    transform: translateY(-3px);
    text-decoration: none;
}

.stats-section {
    background: white;
    padding: 60px 0;
}

.stat-item {
    text-align: center;
    padding: 2rem;
}

.stat-number {
    font-size: 3rem;
    font-weight: bold;
    color: #667eea;
    display: block;
}

.stat-label {
    color: #666;
    font-size: 1.1rem;
    margin-top: 0.5rem;
}
</style>
{% endblock %}

{% block body %}
<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <h1 class="hero-title">
                <i class="fas fa-graduation-cap"></i> Gestion des Stages
            </h1>
            <p class="hero-subtitle">
                La plateforme complète pour gérer efficacement les stages et les demandes des étudiants
            </p>
            <div class="hero-description">
                <p class="lead mb-4">
                    Notre système de gestion des stages simplifie l'ensemble du processus : 
                    de la soumission des demandes à l'affectation des encadrants, 
                    en passant par le suivi des documents et l'évaluation des stages.
                </p>
                <div class="mt-4">
                    {% if app.user %}
                        <a href="{{ path('app_home') }}" class="btn btn-light btn-lg mr-3">
                            <i class="fas fa-dashboard"></i> Accéder au tableau de bord
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-light btn-lg mr-3">
                            <i class="fas fa-sign-in-alt"></i> Se connecter
                        </a>
                        <a href="{{ path('app_register') }}" class="btn btn-outline-light btn-lg">
                            <i class="fas fa-user-plus"></i> Créer un compte
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-4 font-weight-bold text-dark">Une Solution Complète</h2>
            <p class="lead text-muted">Découvrez toutes les fonctionnalités de notre plateforme</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                        <i class="fas fa-users"></i>
                    </div>
                    <h3 class="feature-title">Gestion des Étudiants</h3>
                    <p class="feature-description">
                        Suivez facilement tous les étudiants, leurs informations et leur progression 
                        dans le processus de stage. Interface intuitive pour les étudiants 
                        afin de soumettre leurs demandes.
                    </p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
                        <i class="fas fa-briefcase"></i>
                    </div>
                    <h3 class="feature-title">Offres de Stages</h3>
                    <p class="feature-description">
                        Gérez les offres de stage par département, consultez les disponibilités 
                        et assurez une meilleure correspondance entre les étudiants 
                        et les opportunités de stage.
                    </p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white;">
                        <i class="fas fa-chalkboard-teacher"></i>
                    </div>
                    <h3 class="feature-title">Encadrement</h3>
                    <p class="feature-description">
                        Système complet pour les encadrants : suivi des étudiants assignés, 
                        validation des documents, évaluation des stages 
                        et communication efficace.
                    </p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white;">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <h3 class="feature-title">Documents</h3>
                    <p class="feature-description">
                        Gérez tous les documents relatifs aux stages : rapports, 
                        conventions, évaluations. Système de validation 
                        et suivi des soumissions.
                    </p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); color: white;">
                        <i class="fas fa-building"></i>
                    </div>
                    <h3 class="feature-title">Départements</h3>
                    <p class="feature-description">
                        Organisation par département pour une meilleure gestion 
                        des ressources et des spécialités. 
                        Suivi des stages par domaine d'expertise.
                    </p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background: linear-gradient(135deg, #30cfd0 0%, #330867 100%); color: white;">
                        <i class="fas fa-chart-bar"></i>
                    </div>
                    <h3 class="feature-title">Administration</h3>
                    <p class="feature-description">
                        Tableau de bord complet pour les administrateurs : 
                        gestion des utilisateurs, statistiques, 
                        configuration du système et supervision.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="stats-section">
    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <div class="stat-item">
                    <span class="stat-number">{{ etudiants|default(150) }}</span>
                    <div class="stat-label">Étudiants</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-item">
                    <span class="stat-number">{{ stages|default(45) }}</span>
                    <div class="stat-label">Stages disponibles</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-item">
                    <span class="stat-number">{{ demandes|default(89) }}</span>
                    <div class="stat-label">Demandes traitées</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-item">
                    <span class="stat-number">{{ departments|default(8) }}</span>
                    <div class="stat-label">Départements</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section">
    <div class="container">
        <h2 class="cta-title">Prêt à commencer ?</h2>
        <p class="cta-subtitle">
            Rejoignez notre plateforme et simplifiez la gestion des stages
        </p>
        <div class="mt-4">
            {% if app.user %}
                <a href="{{ path('app_home') }}" class="btn-cta">
                    <i class="fas fa-dashboard"></i> Accéder au tableau de bord
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn-cta">
                    <i class="fas fa-sign-in-alt"></i> Se connecter
                </a>
                <a href="{{ path('app_register') }}" class="btn-cta">
                    <i class="fas fa-user-plus"></i> Créer un compte
                </a>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
