{% extends 'base.html.twig' %}

{% block title %}Détails Département{% endblock %}

{% block body %}
<h1 class="mb-4">Détails du département</h1>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Nom:</strong> {{ department.nom }}</p>
        <p><strong>Description:</strong> {{ department.description }}</p>
        <p><strong>Nombre de stages:</strong> {{ department.stages|length }}</p>
    </div>
</div>

<a class="btn btn-warning" href="{{ path('app_department_edit', {'id': department.id}) }}">Modifier</a>
<a class="btn btn-secondary" href="{{ path('app_department_index') }}">Retour</a>
{% endblock %}
