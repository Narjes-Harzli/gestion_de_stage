{% extends 'base.html.twig' %}

{% block title %}Départements{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-building"></i> Départements</h1>
    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENCADRANT') %}
        <a href="{{ path('app_department_new') }}" class="btn btn-success">Ajouter</a>
    {% endif %}
</div>

<div class="card">
    <div class="card-body">
        {% if departments is empty %}
            <div class="alert alert-info mb-0">Aucun département.</div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="thead-dark">
                    <tr>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Stages</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for department in departments %}
                        <tr>
                            <td>{{ department.nom }}</td>
                            <td>{{ department.description }}</td>
                            <td>{{ department.stages|length }}</td>
                            <td>
                                <a class="btn btn-sm btn-info" href="{{ path('app_department_show', {'id': department.id}) }}">Voir</a>
                                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENCADRANT') %}
                                    <a class="btn btn-sm btn-warning" href="{{ path('app_department_edit', {'id': department.id}) }}">Modifier</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
